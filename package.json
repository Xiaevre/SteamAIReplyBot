{
  "name": "steam-ai-reply-bot",
  "version": "1.0.3",
  "description": "Production long-running low-resource Steam AI comment reply bot for Windows",
  "main": "dist/index.js",
  "scripts": {
    "login": "node dist/index.js --login",
    "start": "node dist/index.js --headless",
    "dev": "node dist/index.js",
    "dry-run": "node dist/index.js --dry-run",
    "stats": "node dist/index.js --stats",
    "build": "node scripts/build.js",
    "package": "node scripts/package.js",
    "test": "node tests/runAllTests.js"
  },
  "keywords": [
    "steam",
    "bot",
    "deepseek",
    "ai",
    "automation",
    "playwright"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.40.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.0.0"
  }
}

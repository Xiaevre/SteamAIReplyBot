# =======================================================
# SteamAIReplyBot Comprehensive .gitignore
# =======================================================

# Runtime & User Persistence Directories
data/
release/
dist/
build/
bin/
browsers/

# Databases & SQLite Journal Files
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Sensitive Credentials, Secrets & Real Configurations
.env
.env.*
!.env.example
config.json
runtime-control.json
*.local.json

# Browser Profiles, Cookies & Playwright Runtime Artifacts
cookies/
browser-profile/
playwright-temp/
profile-analysis/
.playwright/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Node modules & packaging
node_modules/
package-lock.json

# OS and Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.user
*.pdb

# Scratch Scripts and Temporary Dump Files
scratch*
test_regression*
test_live*
test_check*
kill_launcher.ps1
inspect_cookies.js
release.zip
*.tar.gz
*.zip
